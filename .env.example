# Copy to .env (git-ignored), fill in, then:
#   supabase secrets set --env-file .env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Which gateway create-order uses: cashfree (default) or razorpay.
# Must match PAYMENT_GATEWAY in assets/config.js.
PAYMENT_GATEWAY=cashfree

# Cashfree — Merchant Dashboard → Developers → API Keys (Test keys first)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox for Test keys, production for Live keys
CASHFREE_ENV=sandbox
# Public URL of the tip site (Cashfree sends the viewer back to SITE_URL/success.html)
SITE_URL=https://sohaltsx.github.io/Tips

# Razorpay (optional fallback) — Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay — Dashboard → Webhooks → the secret you typed when adding the webhook
RAZORPAY_WEBHOOK_SECRET=

# Streamlabs — access token with the donations.create scope
STREAMLABS_ACCESS_TOKEN=
# Optional override if Streamlabs changes the endpoint
# STREAMLABS_DONATIONS_URL=https://streamlabs.com/api/v2.0/donations

# Comma-separated list of origins allowed to call create-order
ALLOWED_ORIGIN=https://sohaltsx.github.io,http://localhost:8080

# Must match assets/config.js
MIN_AMOUNT=10
MAX_AMOUNT=50000
