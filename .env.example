# Copy to .env (git-ignored), fill in, then:
#   supabase secrets set --env-file .env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Razorpay — Dashboard → Account & Settings → API Keys (use rzp_test_ keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay — Dashboard → Webhooks → the secret you typed when adding the webhook
RAZORPAY_WEBHOOK_SECRET=

# Streamlabs — access token with the donations.create scope
STREAMLABS_ACCESS_TOKEN=
# Optional override if Streamlabs changes the endpoint
# STREAMLABS_DONATIONS_URL=https://streamlabs.com/api/v1.0/donations

# Comma-separated list of origins allowed to call create-order
ALLOWED_ORIGIN=https://sohaltsx.github.io,http://localhost:8080

# Must match assets/config.js
MIN_AMOUNT=10
MAX_AMOUNT=50000
